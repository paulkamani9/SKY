# Sanity — from https://sanity.io/manage (Project settings → API)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Any random string. Must match the secret set on the Sanity webhook.
SANITY_REVALIDATE_SECRET=


# Same values under the prefix the Sanity CLI inlines into the hosted Studio
# build (npx sanity deploy). Not secret.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2024-10-01
